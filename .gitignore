# Local-only planning and scratch. Never commit personal notes, drafts,
# or per-machine working files here. docs/internal/ stays TRACKED (D-12,
# docs/internal is tracked in git).
_local/
_LOCAL/

# Session logs live at _local/_agent-context/ (moved 2026-07-20, operator
# direction: session logs carry personal context and stay out of the repo).
# The root entry is a guard: wrap tooling may still write here by habit,
# and anything it writes must never be committed.
_agent-context/

# MemSearch memory index. Machine-local, regenerated, never shared.
.memsearch/

# Impeccable hook caches. Regenerated locally; config.local.json is per-machine.
.impeccable/hook.cache.json
.impeccable/hook.pending.json
.impeccable/config.local.json

# Rust build output
target/
**/target/

# Node / frontend build output
node_modules/
dist/
build/

# Tauri generated code (regenerated by the build; gen/schemas is emitted by tauri-specta)
src-tauri/target/
src-tauri/gen/

# SQLite runtime files. The database itself lives outside the repo
# (a user's library machine), but WAL/SHM siblings can appear during
# local dev against a scratch DB.
*.db-wal
*.db-shm

# OS cruft
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# Editor / IDE
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# Environment / secrets
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
